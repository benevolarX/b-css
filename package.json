{
  "name": "@benevolar/b-css",
  "version": "0.10.0-dev",
  "description": "small css framework",
  "main": "./scss/index.scss",
  "unpkg": "./css/b-css.css",
  "style": "./css/b-css.min.css",
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true,
  "scripts": {
    "start": "bun run build-css -- --watch",
    "build": "bun run build-css && bun run build-min",
    "build-css": "sass --style=expanded --source-map scss/index.scss css/b-css.css",
    "build-min": "postcss css/b-css.css --no-map --use cssnano --output css/b-css.min.css",
    "rebuild": "bun run clean && bun run build",
    "restart": "bun run clean && bun run start",
    "clean": "rimraf css",
    "list-browser": "bunx browserslist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benevolarX/b-css.git"
  },
  "keywords": [
    "b-css",
    "css",
    "framework",
    "responsive",
    "lightweight",
    "front-end",
    "scss",
    "custom-property",
    "flexbox",
    "grid",
    "itcss",
    "oocss"
  ],
  "author": "benevolar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/benevolarX/b-css/issues"
  },
  "homepage": "https://github.com/benevolarX/b-css#readme",
  "devDependencies": {
    "cssnano": "^9.0.2",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.104.0"
  },
  "browserslist": [
    "defaults",
    "last 2 versions",
    ">= 5%",
    "not ie 11",
    "not op_mini all",
    "not edge <= 18",
    "not dead"
  ]
}
